# Environment Variables
# Copy this file to .env.local and update with actual values

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# For production
# EXPO_PUBLIC_API_URL=https://api.unihub.app/api/v1

# Sentry (Error tracking) - Optional
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Amplitude (Analytics) - Optional
# EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key
