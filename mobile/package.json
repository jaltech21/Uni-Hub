    "expo-font": "~11.10.0",
    "expo-file-system": "~15.5.0",
    "expo-image-picker": "~14.7.0",
    "expo-camera": "~13.8.0",
    "expo-keychain": "~12.3.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
