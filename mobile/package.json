{
  "name": "unihub-mobile",
  "version": "0.1.0",
  "description": "UniHub - The All-in-One Student Virtual Assistant (React Native Mobile App)",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "start:expo": "expo start",
    "web": "webpack serve --mode development",
    "build": "webpack --mode production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js",
      "react-native-gesture-handler/jestSetup"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/web/",
      "/android/",
      "/ios/"
    ],
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/app/$1",
      "^@components/(.*)$": "<rootDir>/app/components/$1",
      "^@screens/(.*)$": "<rootDir>/app/screens/$1",
      "^@services/(.*)$": "<rootDir>/app/services/$1",
      "^@context/(.*)$": "<rootDir>/app/context/$1",
      "^@utils/(.*)$": "<rootDir>/app/utils/$1",
      "^@hooks/(.*)$": "<rootDir>/app/hooks/$1",
      "^@types/(.*)$": "<rootDir>/app/types/$1",
      "^@theme/(.*)$": "<rootDir>/app/theme/$1",
      "^@navigation/(.*)$": "<rootDir>/app/navigation/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|nativewind|react-native-css-interop|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)/)"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.14",
    "ajv": "^8.20.0",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "expo": "~50.0.0",
    "expo-camera": "~14.1.3",
    "expo-dev-client": "~3.3.12",
    "expo-device": "~5.9.0",
    "expo-document-picker": "~11.10.1",
    "expo-file-system": "~16.0.9",
    "expo-image-picker": "~14.7.0",
    "expo-keychain": "1.0.1",
    "expo-notifications": "~0.27.0",
    "expo-status-bar": "~1.11.1",
    "nativewind": "~4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-keychain": "^8.1.0",
    "react-native-paper": "^5.11.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-web": "^0.19.13",
    "tailwindcss": "^3.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.54.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "typescript": "^5.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.1"
  }
}
