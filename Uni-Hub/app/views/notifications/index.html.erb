<div class="max-w-5xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex justify-between items-center mb-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-2">
          Notifications
          <% if @unread_count > 0 %>
            <span class="px-3 py-1 text-sm font-medium bg-blue-100 text-blue-700 rounded-full"><%= @unread_count %> unread</span>
          <% end %>
        </h1>
        <p class="text-gray-600 mt-1">Stay up to date with your classes, assignments, and schedules.</p>
      </div>
      <% if @notifications.any? %>
        <%= button_to "Mark all as read", mark_all_as_read_notifications_path, method: :patch,
            class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition", disabled: @unread_count.zero? %>
      <% end %>
    </div>
  </div>

  <!-- Notification List -->
  <% if @notifications.any? %>
    <div class="space-y-3">
      <% @notifications.each do |notification| %>
        <% unread = !notification.read %>
        <div class="<%= unread ? 'bg-white border-l-4 border-blue-500 shadow-md' : 'bg-white border-l-4 border-gray-300 shadow-sm' %> rounded-lg p-5 flex items-start justify-between gap-4 hover:shadow-lg transition-shadow">
          <div class="flex items-start gap-4 min-w-0">
            <!-- Icon -->
            <span class="mt-1 inline-flex items-center justify-center w-10 h-10 rounded-full <%= notification.read ? 'bg-gray-100 text-gray-500' : 'bg-blue-50 text-blue-600' %> flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
            </span>

            <!-- Content -->
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="<%= unread ? 'font-semibold text-gray-900' : 'font-medium text-gray-700' %>"><%= notification.title %></h3>
                <% if unread %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">New</span>
                <% end %>
              </div>
              <p class="text-sm text-gray-600 mt-1 break-words"><%= notification.message %></p>
              <p class="text-xs text-gray-400 mt-2"><%= notification.time_ago %></p>
              <% if notification.action_url.present? %>
                <a href="<%= notification.action_url %>" class="text-sm text-blue-600 hover:text-blue-800 mt-2 inline-block">View details →</a>
              <% end %>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-col items-end gap-2 flex-shrink-0">
            <% if unread %>
              <%= button_to "Mark as read", mark_as_read_notification_path(notification), method: :patch,
                  class: "text-sm text-gray-600 hover:text-blue-700" %>
            <% end %>
            <%= button_to "Delete", notification_path(notification), method: :delete,
                data: { confirm: "Delete this notification?" },
                class: "text-sm text-red-500 hover:text-red-700" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-lg shadow">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No notifications</h3>
      <p class="mt-1 text-sm text-gray-500">You're all caught up. New activity will appear here.</p>
    </div>
  <% end %>
</div>